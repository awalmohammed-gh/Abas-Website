{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && npm run build:shared && npm run build -w @aba-mart/web",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_SERVICE_URL" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "cd ../.. && npm run build:shared"
    }
  },
  "rewrites": [
    { "source": "/api/revalidate", "destination": { "service": "web" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
