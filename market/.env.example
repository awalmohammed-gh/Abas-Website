# ---------------------------------------------------------------------------
# ABA Mart - the only env file for the whole project. Copy to market/.env and
# fill in your own values. Real .env files are ignored by Git.
# The API reads it through apps/api/src/config/loadEnvironment.ts (and validates
# every value at startup in src/config/env.ts); the web app reads it through
# apps/web/next.config.ts. Variables set by the host (deployment settings) win.
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets in them.
# ---------------------------------------------------------------------------

# --- API server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# MongoDB Atlas (or any MongoDB 6+ replica set - order confirmation uses transactions)
MONGODB_URI=
MONGODB_DB_NAME=aba-mart
# Optional. Set if you see "querySrv ECONNREFUSED" on Windows: Node's resolver
# can't do SRV lookups on some networks. Comma-separated resolver IPs.
DNS_SERVERS=

# --- Admin sessions ---
# JWT_SECRET must be at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=8

# --- Admin account ---
# The API synchronizes this account on startup; create-admin also applies it manually.
# The sign-in ID need not be a deliverable email address.
# Password: at least 10 characters with letters and numbers. There is no default account.
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=super_admin

# --- CORS and cookies ---
# Comma-separated list of storefront origins allowed to call the API (CORS + CSRF origin check)
# Local development: also list http://127.0.0.1:3000 and any LAN origin you open the
# store from (e.g. http://192.168.1.20:3000), keeping localhost first.
CLIENT_ORIGIN=http://localhost:3000
# Same site (e.g. shop.example.com + api.example.com): lax.
# Different sites (e.g. *.vercel.app + *.onrender.com): none, with COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false
# Optional, e.g. .example.com to share across subdomains
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/Nginx), used for rate limiting by IP
TRUST_PROXY=0

# --- Cloudinary ---
# Image storage (only URLs and public ids are stored in MongoDB). The cloud name also
# restricts next/image to this account's images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aba-mart
MAX_UPLOAD_MB=4

# --- Storefront cache revalidation (used by both the API and the web app) ---
# REVALIDATE_SECRET: 24+ characters, server-only.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Storefront origin used in shared order preview links. Defaults to the first CLIENT_ORIGIN.
# Use the public HTTPS storefront URL in production, never the API hostname.
STOREFRONT_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Store ---
# WhatsApp number customer orders are sent to, used when store settings are first created.
# International format, e.g. +233241234567. Admins can change it later in Admin > Settings.
STORE_WHATSAPP_NUMBER=233278857814

# --- Web Push (VAPID, optional) ---
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY secret and on the server. The browser receives only the public key
# from GET /api/push/config. Changing the keys invalidates every existing push subscription.
# VAPID_SUBJECT is a contact for push services: mailto:you@example.com or your https:// site URL.
# Web Push needs HTTPS in production (localhost is allowed for development).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Web app (Next.js) ---
# Public URL of the Express API, including /api (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Public URL of this storefront (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: URL the Next.js server uses to reach the API (e.g. a private network URL).
# Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Development only: extra hosts allowed to open the dev server besides localhost and
# 127.0.0.1, comma-separated (e.g. your LAN IP for phone testing: 192.168.1.20).
# Add the matching http://<host>:3000 origin to CLIENT_ORIGIN as well.
ALLOWED_DEV_ORIGINS=
