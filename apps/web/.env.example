# ---------------------------------------------------------------------------
# ABA Mart web (Next.js). Copy to .env.local for development.
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets in them.
# ---------------------------------------------------------------------------

# Public URL of the Express API, including /api (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL of this storefront (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: URL the Next.js server uses to reach the API (e.g. a private network URL).
# Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Shared secret the API uses to trigger cache revalidation (POST /api/revalidate).
# Must match REVALIDATE_SECRET in apps/api/.env. Server-only.
REVALIDATE_SECRET=

# Cloudinary cloud name - restricts next/image to this account's images. Not secret.
CLOUDINARY_CLOUD_NAME=
