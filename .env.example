# Primary API credentials. Copy to market/.env and fill in your own values.
# Real .env files are ignored by Git. Never use NEXT_PUBLIC_ for secrets.
MONGODB_URI=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET_KEY=

# At least 32 random characters, used for JWT signing and session protection.
jwt_key=

# Static admin sign-in ID and password. An ID need not be a deliverable email address.
# Password must contain at least 10 characters, including letters and numbers.
admin_email=
admin_psd=
